# Copy to .env and set your own infrastructure. These values are also baked
# into the Content-Security-Policy at build time.
VITE_RELAY_URL=wss://wekonet-relay.onrender.com/ws
VITE_APP_BASE=https://wekonet-relay.onrender.com/b/
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# JSON array of RTCIceServer objects (keep TURN credentials in CI secrets)
# Optional: add a TURN server for strict networks, e.g. from Metered / Twilio / Cloudflare
VITE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun.cloudflare.com:3478"]}]
