{
  "name": "wekonet",
  "productName": "WeKoNet",
  "version": "1.0.0",
  "description": "WeKoNet Connect — beacon-initiated, end-to-end encrypted P2P voice, video, chat, location sharing and SOS for up to 3 people.",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "AGPL-3.0-or-later",
  "author": "WeKoNet",
  "homepage": "https://wekonet.app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "relay": "node server/relay.js",
    "cap:android": "npm run build && npx cap add android && node scripts/patch-android.mjs && npx cap sync android",
    "cap:ios": "npm run build && npx cap add ios && node scripts/patch-ios.mjs && npx cap sync ios",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:pi": "npm run build && electron-builder --linux AppImage deb --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/post-quantum": "^0.5.0",
    "dompurify": "^3.2.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "plist": "^3.1.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "app.wekonet.connect",
    "productName": "WeKoNet",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "protocols": [{ "name": "WeKoNet Beacon", "schemes": ["wekonet"] }],
    "win": { "icon": "resources/icon.png", "artifactName": "WeKoNet-${version}-${arch}-${target}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Network",
      "artifactName": "WeKoNet-${version}-${arch}.${ext}",
      "mimeTypes": ["x-scheme-handler/wekonet"]
    }
  }
}
